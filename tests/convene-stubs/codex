#!/usr/bin/env python3
"""A stand-in `codex` for the convene tests; see the claude stub."""
import json
import os
import re
import sys

args = sys.argv[1:]
if args == ["--version"]:
    print("codex-cli 0.155.1")
    sys.exit(0)
if "--help" in args:
    print("Run Codex non-interactively\n  --ignore-user-config")
    sys.exit(0)
for key in ("web_search", "personality"):
    if f'{key}="bogus"' in args:
        valid = "`disabled`, `live`" if key == "web_search" else "`none`, `friendly`"
        print(f"error: unknown variant `bogus` for {key}, expected one of {valid}", file=sys.stderr)
        sys.exit(1)

home = os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")
os.makedirs(home, exist_ok=True)
prompt = sys.stdin.read()
scenario = (re.search(r"\[\[stub:([a-z-]+)\]\]", prompt) or [None, "success"])[1]
if scenario.endswith("-once"):
    marker = os.path.join(home, "stub-" + scenario)
    if os.path.exists(marker):
        scenario = "success"
    else:
        open(marker, "w").close()
        scenario = scenario[: -len("-once")]
if "Continue from where you were" in prompt:
    scenario = "success"
model = args[args.index("-m") + 1]
effort = next((a.split("=", 1)[1].strip('"') for a in args if a.startswith("model_reasoning_effort=")), None)
sandbox = args[args.index("-s") + 1] if "-s" in args else next(
    (a.split("=", 1)[1].strip('"') for a in args if a.startswith("sandbox_mode=")), None)
resumed = args[args.index("resume") + 1] if "resume" in args else None
sid = resumed or "11111111-1111-4111-8111-111111111111"
had_auth = os.path.exists(os.path.join(home, "auth.json"))
with open(os.path.join(home, "stub-calls.jsonl"), "a") as log:
    log.write(json.dumps({"argv": args, "cwd": os.getcwd(), "scenario": scenario,
                          "had_auth": had_auth, "env": {k: os.environ.get(k) for k in
                          ("HOME", "CODEX_HOME", "PWD", "SECRET_FROM_OPERATOR")}}) + "\n")
if not had_auth:
    print("error: not logged in; run `codex login`", file=sys.stderr)
    sys.exit(1)

def emit(row):
    sys.stdout.write(json.dumps(row) + "\n")
    sys.stdout.flush()

served = "gpt-4.1-mini" if scenario == "mismatch" else model
directory = os.path.join(home, "sessions", "2026", "09", "21")
os.makedirs(directory, exist_ok=True)
with open(os.path.join(directory, f"rollout-2026-09-21T00-00-00-{sid}.jsonl"), "a") as handle:
    handle.write(json.dumps({"type": "session_meta", "payload": {"id": sid}}) + "\n")
    handle.write(json.dumps({"type": "turn_context", "payload": {
        "model": served, "effort": effort, "sandbox_policy": {"type": sandbox}}}) + "\n")
    if scenario == "compaction":
        handle.write(json.dumps({"type": "event_msg", "payload": {"type": "context_compacted"}}) + "\n")

emit({"type": "thread.started", "thread_id": sid})
if scenario == "quota-refused":
    emit({"type": "turn.failed", "error": {"code": "rate_limit_exceeded",
          "message": "rate limit exceeded", "resets_at": 1900000000}})
    sys.exit(1)
emit({"type": "item.completed", "item": {"type": "reasoning", "text": "thinking"}})
if scenario == "tools":
    emit({"type": "item.completed", "item": {"type": "command_execution",
          "command": "cat materials/diff.patch", "exit_code": 0}})
if scenario == "web":
    emit({"type": "item.completed", "item": {"type": "web_search", "query": "x"}})
text = "## F1 Stub finding\n\nseverity: note\n\nCodex stub finding.\n"
boards = sorted(os.listdir("board")) if os.path.isdir("board") else []
if boards:
    text += f"\nI read {boards[-1]}.\n"
asked = re.search(r"Write the work itself to outbox/(\S+),", prompt)
# A read-only sandbox refuses every write, so only a workspace-write seat
# can leave a file behind; a stub that wrote anyway would hide that.
if asked and sandbox == "workspace-write":
    os.makedirs("outbox", exist_ok=True)
    with open(os.path.join("outbox", asked.group(1)), "w") as made:
        made.write(f"Deliverable {asked.group(1)} from codex.\n")
if scenario == "canary":
    text = f"HOME={os.environ.get('HOME')} CWD={os.getcwd()} SANDBOX={sandbox}"
emit({"type": "item.completed", "item": {"type": "agent_message", "text": text}})
if scenario == "quota-interrupted":
    emit({"type": "turn.failed", "error": {"code": "insufficient_quota", "message": "quota"}})
    sys.exit(1)
emit({"type": "turn.completed", "usage": {"input_tokens": 2000, "cached_input_tokens": 1500,
      "output_tokens": 210, "reasoning_output_tokens": 50}})
